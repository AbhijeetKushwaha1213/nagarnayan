# ─────────────────────────────────────────────────────────────────────────────
# Nagar Nayan Backend — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment files (NEVER commit secrets)
.env
.env.*
.env.example

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.coveragerc

# IDEs
.idea/
.vscode/
*.swp
*.swo

# macOS
.DS_Store

# Docker
*.pid

# Alembic
# (keep alembic/versions/ tracked in git)

# Logs
*.log
logs/
