# ============================================================
# Nagar Nayan — Video Stream Server configuration
# Copy to `.env` and adjust as needed:  cp .env.example .env
# All values have sensible defaults in docker-compose.yml.
# ============================================================

# ---- Host ports (host:container) ----
RTSP_PORT=8554
HLS_PORT=8888
WEBRTC_PORT=8889
WEBRTC_ICE_PORT=8189

# ---- Stream source ----
# File must exist inside ./videos
VIDEO_FILE=bus_front_01.mp4
# Path the stream is published/consumed at → rtsp://localhost:8554/<STREAM_PATH>
STREAM_PATH=bus/front

# ---- FFmpeg behaviour ----
# tcp is the most reliable transport for OpenCV / VLC.
RTSP_TRANSPORT=tcp
# true  = copy the source codec (lowest CPU, requires H.264 source)
# false = re-encode to H.264 (maximum compatibility) — recommended default
STREAM_COPY=false
TARGET_FPS=25
GOP=50
# Seconds to wait before retrying a failed ffmpeg / MediaMTX connection
RETRY_DELAY=3
