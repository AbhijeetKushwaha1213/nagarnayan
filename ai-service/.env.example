# ─────────────────────────────────────────────────────────────────────────────
# Nagar Nayan — AI Video Intelligence Service Environment Variables
# Phase 4: Validated Detection → Backend Ingestion
# ─────────────────────────────────────────────────────────────────────────────

# RTSP Stream Source
RTSP_URL=rtsp://localhost:8554/bus/front

# Sensing Infrastructure Identity (UUIDs from Backend)
# IMPORTANT: These are example UUIDs. In a real integration, BUS_ID, CAMERA_ID,
# and STREAM_ID must correspond to existing, registered records in the backend database.
# The AI service does NOT create backend records automatically.
BUS_ID=00000000-0000-0000-0000-000000000001
CAMERA_ID=00000000-0000-0000-0000-000000000001
STREAM_ID=00000000-0000-0000-0000-000000000001

# Frame Sampling Rate (FPS)
FRAME_SAMPLE_FPS=5.0

# Reconnect & Resilience
RECONNECT_DELAY_SECONDS=5.0
MAX_RECONNECT_ATTEMPTS=0
STREAM_TIMEOUT_SECONDS=10.0

# YOLO Object Detection
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.25
YOLO_IOU_THRESHOLD=0.45
YOLO_DEVICE=cpu
YOLO_IMAGE_SIZE=640

# Object Tracking (Phase 3)
TRACKING_ENABLED=true
TRACKER_TYPE=bytetrack.yaml
TRACKING_IOU_THRESHOLD=0.50
TRACK_MAX_AGE=30

# Multi-Frame Temporal Validation (Phase 3)
VALIDATION_MIN_FRAMES=3
VALIDATION_WINDOW_FRAMES=5
VALIDATION_MIN_CONFIDENCE=0.30

# Backend Integration (Phase 4)
# Configured for Nagar Nayan FastAPI backend running on port 8080
BACKEND_BASE_URL=http://localhost:8080
BACKEND_API_PREFIX=/api/v1
BACKEND_REQUEST_TIMEOUT_SECONDS=5.0
BACKEND_MAX_RETRIES=3
BACKEND_RETRY_DELAY_SECONDS=1.0
BACKEND_RETRY_BACKOFF_BASE=0.5
BACKEND_QUEUE_MAX_SIZE=100
BACKEND_DUPLICATE_COOLDOWN_SECONDS=10.0

# Logging & Telemetry
STATUS_LOG_INTERVAL_SECONDS=5.0
LOG_LEVEL=INFO
